{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ontology/concept_graph.schema.json",
 "title": "PPA L0-L3 Concept Graph",
 "description": "Schema for ontology/concept_graph.json. Validated by scripts/validate_ppa_knowledge.py (stdlib subset validator: type, const, enum, pattern, minLength, minimum, maximum, minItems, uniqueItems, required, properties, additionalProperties, items, $ref). Edge symmetry is enforced via x-relation-inverses: every edge A -[r]-> B requires B -[inverse(r)]-> A.",
 "x-relation-inverses": {
  "generalizes": "specializes",
  "specializes": "generalizes",
  "depends_on": "prerequisite_of",
  "prerequisite_of": "depends_on",
  "refines": "refined_by",
  "refined_by": "refines",
  "part_of": "has_part",
  "has_part": "part_of",
  "instance_of": "has_instance",
  "has_instance": "instance_of",
  "proves": "proved_by",
  "proved_by": "proves",
  "implements": "implemented_by",
  "implemented_by": "implements",
  "approximates": "approximated_by",
  "approximated_by": "approximates",
  "corresponds_to": "corresponds_to",
  "equivalent_to": "equivalent_to",
  "contrasts_with": "contrasts_with",
  "related_to": "related_to"
 },
 "type": "object",
 "required": ["schema_version", "concepts"],
 "additionalProperties": false,
 "properties": {
  "schema_version": {"const": 1},
  "description": {"type": "string"},
  "concepts": {
   "type": "array",
   "items": {"$ref": "#/$defs/concept"}
  }
 },
 "$defs": {
  "concept": {
   "type": "object",
   "required": ["id", "title", "altitude", "unit", "citations", "formal_summary",
                "projections", "related_edges", "artifact_refs"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^ppa\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "altitude": {"enum": ["L0", "L1", "L2", "L3"]},
    "unit": {"enum": ["U0", "U1", "U2a", "U2b", "U3a", "U3b", "U4a", "U4b",
                      "U5a", "U5b", "U6", "X"]},
    "citations": {
     "type": "array",
     "minItems": 1,
     "items": {"$ref": "#/$defs/citation"}
    },
    "formal_summary": {"type": "string", "minLength": 10},
    "conditions": {
     "type": "array",
     "items": {"type": "string", "minLength": 1}
    },
    "projections": {"$ref": "#/$defs/projections"},
    "related_edges": {
     "type": "array",
     "items": {"$ref": "#/$defs/edge"}
    },
    "artifact_refs": {
     "type": "array",
     "uniqueItems": true,
     "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./#-]+$"}
    },
    "artifact_exclusion": {"type": ["string", "null"], "minLength": 3},
    "issue_refs": {
     "type": "array",
     "uniqueItems": true,
     "items": {"type": "string", "pattern": "^(?:EPIC|ISS-W\\d|REF|BKL)-\\d{2,3}$"}
    },
    "external_terms": {
     "type": "array",
     "uniqueItems": true,
     "items": {"type": "string", "minLength": 1}
    }
   }
  },
  "citation": {
   "type": "object",
   "required": ["chapter_or_app", "section", "book_page", "pdf_page", "table_or_fig"],
   "additionalProperties": false,
   "properties": {
    "chapter_or_app": {
     "type": "string",
     "pattern": "^(?:[1-6]|[ABC]|Preface|Contents|List of Tables|List of Figures|Notation|Index|Bibliography)$"
    },
    "section": {
     "type": ["string", "null"],
     "pattern": "^(?:[1-6ABC](?:\\.\\d{1,2}){1,3}|Intro|Preface|Concluding Remarks|Mini Projects|Exercises|\\[\\d{1,3}\\])$"
    },
    "book_page": {"type": ["integer", "null"], "minimum": 1, "maximum": 452},
    "book_page_roman": {"type": ["string", "null"], "pattern": "^[IVXLCDM]+$"},
    "pdf_page": {"type": "integer", "minimum": 1, "maximum": 465},
    "table_or_fig": {
     "type": ["string", "null"],
     "pattern": "^(?:Table|Figure) [1-6ABC]\\.\\d{1,2}$"
    }
   }
  },
  "projections": {
   "type": "object",
   "required": ["cyber", "swe_architecture", "practical_debugging", "cs_theory"],
   "additionalProperties": false,
   "properties": {
    "cyber": {"type": "string", "minLength": 1},
    "swe_architecture": {"type": "string", "minLength": 1},
    "practical_debugging": {"type": "string", "minLength": 1},
    "cs_theory": {"type": "string", "minLength": 1}
   }
  },
  "edge_basis": {
   "type": "object",
   "required": ["unification_id", "citations", "conditions", "differs"],
   "additionalProperties": false,
   "properties": {
    "unification_id": {"type": "string", "pattern": "^U(?:[1-9]|10)$"},
    "citations": {
     "type": "array",
     "minItems": 1,
     "items": {"$ref": "#/$defs/citation"}
    },
    "conditions": {
     "type": "array",
     "minItems": 1,
     "items": {"type": "string", "minLength": 1}
    },
    "differs": {
     "type": "array",
     "minItems": 1,
     "items": {"type": "string", "minLength": 1}
    }
   }
  },
  "edge": {
   "type": "object",
   "required": ["target_id", "relation"],
   "additionalProperties": false,
   "properties": {
    "target_id": {"type": "string", "pattern": "^ppa\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "relation": {"enum": ["generalizes", "specializes", "depends_on", "prerequisite_of",
                          "refines", "refined_by", "part_of", "has_part", "instance_of",
                          "has_instance", "proves", "proved_by", "implements",
                          "implemented_by", "approximates", "approximated_by",
                          "corresponds_to", "equivalent_to", "contrasts_with",
                          "related_to"]},
    "basis": {"$ref": "#/$defs/edge_basis"},
    "citations": {
     "type": "array",
     "items": {"$ref": "#/$defs/citation"}
    },
    "preconditions": {
     "type": "array",
     "items": {"type": "string", "minLength": 1}
    }
   }
  }
 }
}
